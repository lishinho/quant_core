{
  "lane": "dividend_v9",
  "strategy": "V9",
  "strategy_name": "红利低波-机器学习增强排序",
  "enabled": true,
  "pool": {
    "sources": ["dividend_low_vol", "hs300", "zz500"],
    "min_listing_days": 365,
    "exclude_st": true,
    "exclude_suspended": true,
    "exclude_risk_warning": true,
    "risk_blacklist": []
  },
  "model": {
    "engine": "lightgbm",
    "fallback_engine": "builtin_gbdt",
    "horizon_days": 5,
    "train_window_days": 750,
    "max_age_days": 7,
    "retrain_every_days": 7,
    "min_train_samples": 2000,
    "params": {
      "objective": "regression",
      "n_estimators": 200,
      "max_depth": 6,
      "learning_rate": 0.05,
      "num_leaves": 31,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_samples": 30,
      "random_state": 42
    },
    "features": [
      "ret_1d", "ret_3d", "ret_5d", "ret_10d", "ret_20d",
      "vol_5d", "vol_20d", "vol_ratio_5_20",
      "turnover_5d", "amount_ratio",
      "ma5_bias", "ma10_bias", "ma20_bias", "ma60_bias",
      "dist_boll_lower", "dist_boll_upper", "boll_width",
      "rsi_14", "macd_dif", "macd_dea", "macd_hist",
      "high_20d_pos", "volume_trend_5d", "amount_log"
    ]
  },
  "blend": {"model_weight": 0.6, "rule_weight": 0.4},
  "market_gate": {
    "index": "sh000300",
    "require_close_above_ma": 60
  },
  "selection": {
    "final_score_min": 85.0,
    "top_pct": 0.2,
    "max_daily_picks": 3
  },
  "scoring": {
    "weights": {"fundamental": 0.3, "industry": 0.15, "valuation_momentum": 0.2, "capital": 0.15, "event": 0.1, "macro": 0.1}
  },
  "trade": {
    "max_positions": 6,
    "per_position_weight": 0.15,
    "take_profit": 0.05,
    "stop_loss": -0.08,
    "max_hold_days": 30,
    "allow_add": false
  }
}
